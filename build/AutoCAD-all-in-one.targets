<Project>
  <PropertyGroup>
    <AutoCadVersion Condition="'$(AutoCadVersion)' == ''">$(AutoCadPackageYear)</AutoCadVersion>
    <DefineConstants Condition="'$(AutoCadAllInOneConstantApplied)' != 'true'">$(DefineConstants);AUTOCAD$(AutoCadPackageYear)</DefineConstants>
    <AutoCadAllInOneConstantApplied>true</AutoCadAllInOneConstantApplied>
  </PropertyGroup>

  <Target Name="ValidateAutoCadAllInOneConsumer" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AutoCadPackageYear)' == ''"
           Text="AutoCAD-all-in-one package year identity is missing." />
    <Error Condition="'$(AutoCadVersion)' != '$(AutoCadPackageYear)'"
           Text="AutoCAD-all-in-one year mismatch: package targets $(AutoCadPackageYear), project requests $(AutoCadVersion)." />
  </Target>

  <Target Name="RemoveAutoCadHostAssembliesFromCopyLocal"
          AfterTargets="ResolveReferences"
          BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <_AutoCadHostAssembly Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'AcCoreMgd'
                                       Or '%(ReferenceCopyLocalPaths.Filename)' == 'AcDbMgd'
                                       Or '%(ReferenceCopyLocalPaths.Filename)' == 'AcMgd'
                                       Or '%(ReferenceCopyLocalPaths.Filename)' == 'AcCui'
                                       Or '%(ReferenceCopyLocalPaths.Filename)' == 'AcWindows'
                                       Or '%(ReferenceCopyLocalPaths.Filename)' == 'AdWindows'
                                       Or '%(ReferenceCopyLocalPaths.Filename)' == 'acdbmgdbrep'" />
      <ReferenceCopyLocalPaths Remove="@(_AutoCadHostAssembly)" />
    </ItemGroup>
  </Target>
</Project>
